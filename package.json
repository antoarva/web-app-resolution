{
  "name": "envelop-offline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first, WebAssembly-powered EnergyPlus IDF editor",
  "scripts": {
    "engine:build": "asc engine/assembly/index.ts --config engine/asconfig.json --target release",
    "engine:debug": "asc engine/assembly/index.ts --config engine/asconfig.json --target debug",
    "dev": "npm run engine:build && vite",
    "build": "npm run engine:build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb": "^8.0.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.451.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.3.2",
    "rete-connection-plugin": "^2.0.5",
    "rete-react-plugin": "^2.1.2",
    "rete-render-utils": "^2.0.3",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "assemblyscript": "^0.27.30",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
